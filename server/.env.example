# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatapp
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/chatapp

# Server Port & Environment
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_jwt_super_secret_key

# CORS Allowed Client URLs (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.vercel.app

# Redis / Upstash Cache Configuration (Optional)
REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cloudinary Media Storage (Voice notes, images, media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WebRTC STUN / TURN Configuration for Calling (Optional)
# Public Google STUN servers (stun:stun.l.google.com:19302) are used automatically.
# For production relay behind symmetric NATs or restrictive cellular networks:

# Option A: Cloudflare Realtime Calls TURN
# CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token

# Option B: Standard TURN Server (e.g. Coturn, Metered.ca, Twilio, Xirsys)
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password
